<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.fiap.bank</groupId>
        <artifactId>fiap-bank-plataforma-credito</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>fiap-bank-plataforma-credito-presentation</artifactId>
    <name>FIAP Bank - Plataforma de Credito - Presentation</name>
    <description>API RESTful /api/v1 + Controller Adaptador legado (/api/credito) + bootstrap Spring Boot.</description>

    <dependencies>
        <!-- presentation enxerga SOMENTE application em tempo de compilacao -->
        <dependency>
            <groupId>br.com.fiap.bank</groupId>
            <artifactId>fiap-bank-plataforma-credito-application</artifactId>
        </dependency>

        <!-- domain/infrastructure apenas em runtime (application os declara como optional): fora do classpath de compilacao -->
        <dependency>
            <groupId>br.com.fiap.bank</groupId>
            <artifactId>fiap-bank-plataforma-credito-infrastructure</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>br.com.fiap.bank</groupId>
            <artifactId>fiap-bank-plataforma-credito-domain</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-fronteira-presentation</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>br.com.fiap.bank:fiap-bank-plataforma-credito-domain:*:*:compile</exclude>
                                        <exclude>br.com.fiap.bank:fiap-bank-plataforma-credito-infrastructure:*:*:compile</exclude>
                                    </excludes>
                                    <message>[DDD] presentation so pode enxergar application. Acesso direto a domain/infrastructure e proibido.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
