<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.fiap.bank</groupId>
        <artifactId>fiap-bank-core-bancario</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>fiap-bank-core-bancario-presentation</artifactId>
    <name>FIAP Bank - Core Bancario - Presentation</name>
    <description>Ponto de entrada RESTful (/api/v1): controllers, tratamento global de excecoes e bootstrap Spring Boot.</description>

    <dependencies>
        <!-- presentation enxerga SOMENTE application em tempo de compilacao -->
        <dependency>
            <groupId>br.com.fiap.bank</groupId>
            <artifactId>fiap-bank-core-bancario-application</artifactId>
        </dependency>

        <!--
            Blindagem em tempo de compilacao: application declara domain/infrastructure como optional,
            entao eles nao chegam aqui de forma transitiva. A presentation os declara apenas com escopo
            runtime: ficam FORA do classpath de compilacao (qualquer import de classe do dominio ou da
            infraestrutura nesta camada gera erro de compilacao), mas disponiveis em runtime para o Spring.
        -->
        <dependency>
            <groupId>br.com.fiap.bank</groupId>
            <artifactId>fiap-bank-core-bancario-infrastructure</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>br.com.fiap.bank</groupId>
            <artifactId>fiap-bank-core-bancario-domain</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Spring Boot 4 e modular: o console do H2 virou um modulo proprio -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-fronteira-presentation</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- Falha o build se domain/infrastructure aparecerem no classpath de COMPILACAO da presentation -->
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>br.com.fiap.bank:fiap-bank-core-bancario-domain:*:*:compile</exclude>
                                        <exclude>br.com.fiap.bank:fiap-bank-core-bancario-infrastructure:*:*:compile</exclude>
                                    </excludes>
                                    <message>[DDD] presentation so pode enxergar application. Acesso direto a domain/infrastructure e proibido.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
